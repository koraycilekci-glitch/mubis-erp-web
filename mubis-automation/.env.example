# MUBiS Automation - Ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri doldurun.

# API güvenlik anahtarı (Vercel'deki VITE_AUTOMATION_API_KEY ile aynı olmalı)
API_KEY=degistir-bu-anahtari-guclu-bir-seyler-ile

# Supabase (MUBiS ERP ile aynı proje)
SUPABASE_URL=https://gxuqrxmpgoeyykoolmwv.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Yerel PostgreSQL (Docker içinde otomatik ayarlanır)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mubis_automation

# Redis (Docker içinde otomatik ayarlanır)
REDIS_URL=redis://redis:6379/0

# Şifreleme (Vercel'deki VITE_PORTAL_CRYPTO_KEY ile aynı olmalı)
PORTAL_CRYPTO_KEY=degistir-bu-anahtari-32-byte-olacak-sekilde

# Depolama
STORAGE_PROVIDER=supabase
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=client-documents

# Bildirimler (opsiyonel)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

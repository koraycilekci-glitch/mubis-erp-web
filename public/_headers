# 2.7.542: index.html asla onbelleklenmez (her acilista tazelenir), boylece
# yeni surum cikinca tarayici eski JS parcasini kullanmaya devam etmez.
# /assets/* adlari icerik hash'i tasidigi icin guvenle uzun sure onbelleklenir.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

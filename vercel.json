{
  "rewrites": [
    { "source": "/api/tuik-kira", "destination": "/api/external-proxy?route=tuik-kira" },
    { "source": "/api/guncel-parametreler", "destination": "/api/external-proxy?route=guncel-parametreler" },
    { "source": "/api/odeme-hatirlatma", "destination": "/api/external-proxy?route=odeme-hatirlatma" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/external-proxy?route=kira-yenileme-kontrol",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/odeme-hatirlatma",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/analyze-document.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfjs-dist/**"
    },
    "api/analyze-personnel-document.mjs": {
      "maxDuration": 30
    },
    "api/external-proxy.js": {
      "maxDuration": 30
    }
  }
}
